from cognition.agent import CognitiveAgent
from cognition.perception import SensoryInput


def main():
    agent = CognitiveAgent(enable_rl=True)

    scenarios = [
        SensoryInput(vision="A plate of food on a table", sound="", context="hungry"),
        SensoryInput(vision="Dark hallway", sound="Loud bang", context="alarming"),
        SensoryInput(vision="Friend smiling", sound="Hello there", context="social"),
        SensoryInput(vision="Empty room with novel gadgets", sound="humming", context="curious"),
        SensoryInput(vision="Bench in park", sound="birds", context="tired"),
    ]

    for i, scenario in enumerate(scenarios * 3, start=1):
        encoded = agent.perceive(scenario)
        attention = agent.attend(encoded)
        plan = agent.plan(attention)
        action, outcome = agent.decide_and_act(plan)

        print(f"\n[Step {i}] Percept: {scenario.text()}")
        print(f"Attention: { {k: round(v, 2) for k, v in attention.items()} }")
        print(f"Plan: {plan}")
        print(f"Action: {action} -> Outcome: {outcome}")
        print(f"Emotion: valence={agent.emotion.valence:.2f}, arousal={agent.emotion.arousal:.2f}")

    print("\nFinal long-term memory:", agent.long_term_memory.concepts)
    print("Working memory sample:", agent.working_memory.get()[:3])


if __name__ == "__main__":
    main()
